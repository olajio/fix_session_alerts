{
  "trigger": {
    "schedule": {
      "cron": "0 */5 * ? * MON-FRI"
    }
  },
  "input": {
    "chain": {
      "inputs": [
        {
          "groups": {
            "search": {
              "request": {
                "search_type": "query_then_fetch",
                "indices": [
                  "fix_session_schedule"
                ],
                "rest_total_hits_as_int": true,
                "body": {
                  "size": 0,
                  "query": {
                    "bool": {
                      "filter": [
                        {
                          "term": {
                            "group": "{{ ctx.metadata.event_type }}"
                          }
                        },
                        {
                          "term": {
                            "alert_status": "enabled"
                          }
                        }
                      ],
                      "must": [
                        {
                          "script": {
                            "script": {
                              "source": """
                                long currentMillis = new Date().getTime();

                                ZonedDateTime nyTime = ZonedDateTime.ofInstant(
                                  Instant.ofEpochMilli(currentMillis),
                                  ZoneId.of('America/New_York')
                                );

                                int currentHour = nyTime.getHour();
                                int currentMinute = nyTime.getMinute();

                                int startH = doc['start_hour'].value.intValue();
                                int startM = doc['start_minute'].value.intValue();

                                int currentTotal = currentHour * 60 + currentMinute;
                                int startTotal = startH * 60 + startM;
                                int currentTotalLookup = currentTotal - {{ ctx.metadata.lookup_interval }};

                                // Unchanged from the original: did the expected logon time fall inside
                                // the trailing lookup_interval window that ends now?
                                if (!(startTotal <= currentTotal && startTotal > currentTotalLookup)) {
                                  return false;
                                }

                                // Resolve 'days' whichever way it mapped. doc.containsKey() answers
                                // from the INDEX MAPPING, not from this document, so both names are
                                // tried: fix_session_schedule maps 'days' as a bare keyword, while
                                // dynamic default mapping would instead give text + 'days.keyword'.
                                // Checking only one name would let the other shape fall through to
                                // "no restriction" and silently alert on days a session is expected
                                // to be down.
                                def days = null;
                                if (doc.containsKey('days.keyword')) {
                                  days = doc['days.keyword'];
                                } else if (doc.containsKey('days')) {
                                  days = doc['days'];
                                }

                                // days == null   -> 'days' is not in the mapping at all, so no schedule
                                //                   doc uses it yet and this watcher is safe to deploy
                                //                   before the field exists.
                                // days.size()==0 -> mapped, but THIS doc has no value for it
                                //                   (e.g. FIX.4.4:PRODHSSYCAMORE->TRUMID).
                                // Either way the schedule applies every day, exactly as before.
                                if (days == null || days.size() == 0) {
                                  return true;
                                }

                                // Unlike the 53002 connection window, this check can never span
                                // midnight: the guard above requires startTotal <= currentTotal, so the
                                // expected logon being tested always falls earlier on TODAY, for any
                                // lookup_interval. There is therefore no previous-day case to handle
                                // and the day to match is simply today.
                                String logonDay = nyTime.getDayOfWeek().toString();

                                for (def day: days) {
                                  if (day.toString().equals(logonDay)) {
                                    return true;
                                  }
                                }
                                return false;
                              """
                            }
                          }
                        }
                      ]
                    }
                  },
                  "aggs": {
                    "hosts": {
                      "terms": {
                        "field": "target.keyword",
                        "size": 5000
                      }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "groups_hosts": {
            "transform": {
              "script": {
                "source": """
                  // flatten the list of hostnames to use in the errors input
                  return ctx.payload.groups.aggregations.hosts.buckets.stream().map(b -> b.key).collect(Collectors.toList());""",
                "lang": "painless"
              }
            }
          }
        },
        {
          "errors": {
            "search": {
              "request": {
                "search_type": "query_then_fetch",
                "indices": [
                  "prod:filebeat-*"
                ],
                "rest_total_hits_as_int": true,
                "template": {
                  "source": """
                    {
                      "size": 0,
                      "query": {
                        "bool": {
                          "filter": [
                            {
                              "terms": {
                                "_tier": [
                                  "{{ ctx.metadata.data_hot }}",
                                  "{{ ctx.metadata.data_content }}"
                                ]
                              }
                            },
                            {
                              "terms": {
                                "labels.fix_sessionid": {{#toJson}}ctx.payload.groups_hosts._value{{/toJson}}
                              }
                            },
                            {
                              "range": {
                                "@timestamp": {
                                  "gt": "now-{{ ctx.metadata.timeRangeValue }}{{ ctx.metadata.timeRangeUnit }}"
                                }
                              }
                            },
                            {
                              "term": {
                                "service.name": "CAVIAR FIX Gateway"
                              }
                            },
                            {
                              "term": {
                                "labels.fix_event_handler_type": "OnLogon"
                              }
                            },
                            {
                              "term": {
                                "labels.fix_logon_success": "true"
                              }
                            },
                            {
                              "terms": {
                                "cloud.account.name": [
                                  "hedgeserv-app-prd",
                                  "hedgeserv-app-tst"
                                ]
                              }
                            }
                          ]
                        }
                      },
                      "aggs": {
                        "session_id": {
                          "terms": {
                            "field": "labels.fix_sessionid",
                            "size": 5000
                          }
                        }
                      }
                    }
                    """,
                  "lang": "mustache"
                }
              }
            }
          }
        },
        {
          "sessions": {
            "transform": {
              "script": {
                "source": """
                  // flatten the list of hostnames to use in the open_tickets input
                  List active = ctx.payload.errors.aggregations.session_id.buckets.stream().map(b -> b.key).collect(Collectors.toList());
                  List to_alert = [];
                  for (def session: ctx.payload.groups_hosts._value) {
                    if (!active.contains(session)) {
                      to_alert.add(session);
                    }
                  }
                  return to_alert;""",
                "lang": "painless"
              }
            }
          }
        }
      ]
    }
  },
  "condition": {
    "script": {
      "source": """
        // if we have any hosts we need to check them...
        return ctx.payload.sessions._value.size() > 0;
      """,
      "lang": "painless"
    }
  },
  "actions": {
    "open_tickets": {
      "condition": {
        "script": {
          "source": "ctx.payload.to_open.size() > 0",
          "lang": "painless"
        }
      },
      "foreach": "ctx.payload.to_open",
      "max_iterations": 5000,
      "webhook": {
        "scheme": "https",
        "host": "elk-support.hedgeserv.com",
        "port": 443,
        "method": "post",
        "path": "/api/v3/requests",
        "params": {
          "input_data": """{
            "request": {
              "subject": "{{ ctx.metadata.event_type }} - {{ ctx.metadata.service_name }} Alert - {{ ctx.payload.key }}",
              "description": "<h3>{{ ctx.metadata.amdb_name }}</h3> <p>Session ID: {{ ctx.payload.key }}</p> <p><a href='{{ctx.metadata.amdb_link}}'>AMDB</a></p> <p>To open the dashboard, please copy the link below</p> <p>{{ ctx.payload.dashboard_link }}</p>",
              "requester": {
                "name": "service-elastic"
              },
              "template": {
                "name": "Elastic Search Alerts"
              },
              "service_category": {
                "name": "Report an Incident"
              },
              "priority": {
                "name": "{{ ctx.metadata.ticket_priority }}"
              },
              "group": {
                "name": "{{ ctx.metadata.ticket_group }}"
              },
              "status": {
                "name": "Open"
              },
              "udf_fields": {
                "udf_sline_49837": "{{ ctx.trigger.triggered_time }}",
                "udf_sline_53701": "",
                "udf_sline_49808": "{{ ctx.metadata.event_type }}",
                "udf_sline_49805": "{{ ctx.payload.key }}",
                "udf_sline_53703": "{{ ctx.metadata.service_name }}",
                "udf_sline_55201": "",
                "udf_sline_65102": "",
                "udf_sline_65104": ""
              },
              "category": {
                "name": "Elastic-AWS-MT"
              }
            }
          }"""
        },
        "headers": {
          "Content-Type": "application/x-www-form-urlencoded",
          "technician_key": "XXXXXXXX"
        }
      }
    }
  },
  "metadata": {
    "service_name": "FIX Initial Logon Failure",
    "amdb_name": "53001 - FIX Initial Logon Failure",
    "ticket_priority": "1 - Critical",
    "amdb_link": "https://hedgeservcorp.sharepoint.com/sites/GlobalTechnology/AMDB/SitePages/53001.aspx",
    "data_content": "data_content",
    "timeRangeUnit": "m",
    "event_type": "53001",
    "timeRangeValue": 6,
    "dashboard_link": "https://XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX.us-east-1.aws.found.io:9243/s/information-technology/app/discover#/view/admin_53001%20-%20FIX%20Initial%20Logon%20Failure?_g=(filters:!(),refreshInterval:(pause:!t,value:60000),time:(from:now-24h%2Fh,to:now))&_a=(columns:!(labels.fix_sessionid,labels.fix_event_handler_type,labels.fix_logon_success,cloud.account.name),dataSource:(dataViewId:'537f0c0a-3b04-5c03-8b9c-6eee829e73f8',type:dataView),filters:!(('$state':(store:appState),meta:(alias:!n,disabled:!f,field:service.name,index:'537f0c0a-3b04-5c03-8b9c-6eee829e73f8',key:service.name,negate:!f,params:(query:'CAVIAR%20FIX%20Gateway'),type:phrase),query:(match_phrase:(service.name:'CAVIAR%20FIX%20Gateway'))),('$state':(store:appState),meta:(alias:!n,disabled:!f,field:labels.fix_sessionid,index:'537f0c0a-3b04-5c03-8b9c-6eee829e73f8',key:labels.fix_sessionid,negate:!f,params:(query:'SESSION_REPLACEMENT'),type:phrase),query:(match_phrase:(labels.fix_sessionid:'SESSION_REPLACEMENT')))),grid:(),hideChart:!f,interval:auto,query:(language:kuery,query:'labels.fix_event_handler_type:%20%22OnLogon%22%20and%20labels.fix_logon_success:%20%22true%22'),sort:!(!('@timestamp',desc)))",
    "ticket_group": "Service Desk Operations",
    "id": "sdpmt_53001",
    "lookup_interval": 5,
    "data_hot": "data_hot"
  },
  "transform": {
    "script": {
      "source": """
        // store two lists of host buckets
        List to_open = [];
        for (def session: ctx.payload.sessions._value) {
          Map host = new HashMap();
          host.key = session;
          host.dashboard_link = ctx.metadata.dashboard_link.replace('SESSION_REPLACEMENT', host.key);
          to_open.add(host);
        }

        // replace payload with our two lists
        return [
          'to_open': to_open
        ];
      """,
      "lang": "painless"
    }
  }
}

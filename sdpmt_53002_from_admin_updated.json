{
  "trigger": {
    "schedule": {
      "cron": [
        "0 */2 * ? * TUE-FRI",
        "0 */5 0-3 ? * SAT",
        "0 */5 4-23 ? * MON"
      ]
    }
  },
  "input": {
    "chain": {
      "inputs": [
        {
          "groups": {
            "search": {
              "request": {
                "search_type": "query_then_fetch",
                "indices": [
                  "fix_session_schedule"
                ],
                "rest_total_hits_as_int": true,
                "body": {
                  "size": 0,
                  "query": {
                    "bool": {
                      "filter": [
                        {
                          "term": {
                            "group": "{{ ctx.metadata.event_type }}"
                          }
                        },
                        {
                          "term": {
                            "alert_status": "enabled"
                          }
                        }
                      ],
                      "must": [
                        {
                          "script": {
                            "script": {
                              "source": """
                                long currentMillis = new Date().getTime();

                                ZonedDateTime nyTime = ZonedDateTime.ofInstant(
                                  Instant.ofEpochMilli(currentMillis),
                                  ZoneId.of('America/New_York')
                                );

                                int currentHour = nyTime.getHour();
                                int currentMinute = nyTime.getMinute();

                                int startH = doc['start_hour'].value.intValue();
                                int startM = doc['start_minute'].value.intValue();
                                int endH = doc['end_hour'].value.intValue();
                                int endM = doc['end_minute'].value.intValue();

                                int currentTotal = currentHour * 60 + currentMinute;
                                int startTotal = startH * 60 + startM;
                                int endTotal = endH * 60 + endM;

                                if (startTotal <= endTotal) {
                                  return currentTotal >= startTotal && currentTotal < endTotal;
                                } else {
                                  return currentTotal >= startTotal || currentTotal < endTotal;
                                }
                              """
                            }
                          }
                        }
                      ]
                    }
                  },
                  "aggs": {
                    "hosts": {
                      "terms": {
                        "field": "target.keyword",
                        "size": 5000
                      },
                      "aggs": {
                        "account": {
                          "top_hits": {
                            "size": 1,
                            "_source": {
                              "include": [
                                "cloud.account.name"
                              ]
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "groups_hosts": {
            "transform": {
              "script": {
                "source": """
                  // flatten the list of hostnames to use in the errors input
                  return ctx.payload.groups.aggregations.hosts.buckets.stream().map(b -> b.key).collect(Collectors.toList());""",
                "lang": "painless"
              }
            }
          }
        },
        {
          "errors": {
            "search": {
              "request": {
                "search_type": "query_then_fetch",
                "indices": [
                  "prod:filebeat-*"
                ],
                "rest_total_hits_as_int": true,
                "template": {
                  "source": """
                    {
                      "size": 0,
                      "query": {
                        "bool": {
                          "filter": [
                            {
                              "terms": {
                                "_tier": [
                                  "{{ ctx.metadata.data_hot }}",
                                  "{{ ctx.metadata.data_content }}"
                                ]
                              }
                            },
                            {
                              "terms": {
                                "labels.fix_sessionid": {{#toJson}}ctx.payload.groups_hosts._value{{/toJson}}
                              }
                            },
                            {
                              "range": {
                                "@timestamp": {
                                  "gt": "now-{{ ctx.metadata.timeRangeValue }}{{ ctx.metadata.timeRangeUnit }}"
                                }
                              }
                            },
                            {
                              "term": {
                                "service.name": "CAVIAR FIX Gateway"
                              }
                            },
                            {
                              "term": {
                                "labels.fix_msg_type": "0"
                              }
                            },
                            {
                              "term": {
                                "labels.fix_event_handler_type": "{{ ctx.metadata.check_type }}"
                              }
                            },
                            {
                              "terms": {
                                "cloud.account.name": [
                                  "hedgeserv-app-prd",
                                  "hedgeserv-app-tst"
                                ]
                              }
                            }
                          ]
                        }
                      },
                      "aggs": {
                        "session_id": {
                          "terms": {
                            "field": "labels.fix_sessionid",
                            "size": 5000
                          },
                          "aggs": {
                            "data": {
                              "top_hits": {
                                "size": 1,
                                "_source": {
                                  "include": [
                                    "cloud.account.name",
                                    "cloud.region",
                                    "labels.client_code"
                                  ]
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                    """,
                  "lang": "mustache"
                }
              }
            }
          }
        },
        {
          "sessions": {
            "transform": {
              "script": {
                "source": """
                  // flatten the list of hostnames to use in the open_tickets input
                  List active = ctx.payload.errors.aggregations.session_id.buckets.stream().map(b -> b.key).collect(Collectors.toList());
                  List to_alert = [];
                  for (def session: ctx.payload.groups_hosts._value) {
                    if (!active.contains(session)) {
                      to_alert.add(session + "_FromAdmin");
                    }
                  }
                  return to_alert;""",
                "lang": "painless"
              }
            }
          }
        },
        {
          "open_tickets": {
            "search": {
              "request": {
                "search_type": "query_then_fetch",
                "indices": [
                  "sdpmt_tickets"
                ],
                "rest_total_hits_as_int": true,
                "template": {
                  "source": """
                    {
                      "size": 5000,
                      "query": {
                        "bool": {
                          "filter": [
                            {
                              "terms": {
                                "host.target": {{#toJson}}ctx.payload.sessions._value{{/toJson}}
                              }
                            },
                            {
                              "term": {
                                "status": "open"
                              }
                            },
                            {
                              "term": {
                                "event_type": "{{ ctx.metadata.ticket_event_type }}"
                              }
                            }
                          ]
                        }
                      }
                    }
                    """,
                  "lang": "mustache"
                }
              }
            }
          }
        }
      ]
    }
  },
  "condition": {
    "script": {
      "source": """
        // if we have any hosts we need to check them...
        return ctx.payload.sessions._value.size() > 0;
      """,
      "lang": "painless"
    }
  },
  "actions": {
    "comment_tickets": {
      "condition": {
        "script": {
          "source": "ctx.payload.to_comment.size() > 0",
          "lang": "painless"
        }
      },
      "foreach": "ctx.payload.to_comment",
      "max_iterations": 5000,
      "webhook": {
        "scheme": "https",
        "host": "elk-support.hedgeserv.com",
        "port": 443,
        "method": "put",
        "path": "/api/v3/requests/{{ ctx.payload.ticket_id }}",
        "params": {
          "input_data": """{
            "request": {
              "udf_fields": {
                "udf_sline_96001": "{{ ctx.trigger.triggered_time }}"
              }
            }
          }"""
        },
        "headers": {
          "Content-Type": "application/x-www-form-urlencoded",
          "technician_key": "XXXXXXXXXXXXXXXXX"
        },
        "connection_timeout_in_millis": 30000,
        "read_timeout_millis": 30000
      }
    },
    "open_tickets": {
      "condition": {
        "script": {
          "source": "ctx.payload.to_open.size() > 0",
          "lang": "painless"
        }
      },
      "foreach": "ctx.payload.to_open",
      "max_iterations": 5000,
      "webhook": {
        "scheme": "https",
        "host": "elk-support.hedgeserv.com",
        "port": 443,
        "method": "post",
        "path": "/api/v3/requests",
        "params": {
          "input_data": """{
            "request": {
              "subject": "TEST PLEASE IGNORE - {{ ctx.metadata.amdb_name }} Alert - {{ ctx.payload.session_id }} - {{ ctx.payload.cloud_account_name }}",
              "description": "<h3>{{ ctx.metadata.amdb_name }}</h3> <p>Cloud Account: {{ ctx.payload.cloud_account_name }}</p> <p>Check Type: {{ ctx.metadata.check_type }}</p> <p>Session ID: {{ ctx.payload.session_id }}</p> <p><a href='{{ctx.metadata.amdb_link}}'>AMDB</a></p> <p>To open the dashboard, please copy the link below</p> <p><font color=blue>{{ ctx.payload.dashboard_link }}</font></p>",
              "requester": {
                "name": "service-elastic"
              },
              "template": {
                "name": "Elastic Search Alerts"
              },
              "service_category": {
                "name": "Report an Incident"
              },
              "priority": {
                "name": "{{ ctx.payload.ticket_priority }}"
              },
              "group": {
                "name": "{{ ctx.metadata.ticket_group }}"
              },
              "status": {
                "name": "Onhold"
              },
              "technician": {
                "name": "Ola Ola"
              },
              "udf_fields": {
                "udf_sline_49837": "{{ ctx.trigger.triggered_time }}",
                "udf_sline_53701": "",
                "udf_sline_49808": "{{ ctx.metadata.ticket_event_type }}",
                "udf_sline_49805": "{{ ctx.payload.key }}",
                "udf_sline_53703": "{{ ctx.metadata.service_name }}",
                "udf_sline_55201": "",
                "udf_sline_65102": "{{ ctx.payload.cloud_account_name }}",
                "udf_sline_65104": "{{ ctx.payload.cloud_region }}"
              },
              "category": {
                "name": "Elastic-AWS-MT"
              }
            }
          }"""
        },
        "headers": {
          "Content-Type": "application/x-www-form-urlencoded",
          "technician_key": "XXXXXXXXXXXXXXXXX"
        }
      }
    }
  },
  "metadata": {
    "service_name": "FIX Heartbeat Check",
    "amdb_name": "53002 - FIX Heartbeat Check",
    "ticket_event_type": "53002_from_admin",
    "ticket_priority": "1 - Critical",
    "amdb_link": "https://hedgeservcorp.sharepoint.com/sites/GlobalTechnology/AMDB/SitePages/53002.aspx",
    "threshold": 5,
    "check_type": "FromAdmin",
    "data_content": "data_content",
    "timeRangeUnit": "d",
    "event_type": "53002",
    "ticket_group2": "Service Desk Operations",
    "timeRangeValue": 2,
    "dashboard_link": "https://287d86a4b1184182b340bd5074cdfd7e.us-east-1.aws.found.io:9243/s/information-technology/app/discover#/view/admin_53002%20-%20FIX%20FromAdmin%20heartbeat%20check?_g=(filters:!(),refreshInterval:(pause:!t,value:60000),time:(from:now-15m,to:now))&_a=(columns:!(labels.fix_sessionid,labels.fix_msg_type,labels.fix_event_handler_type),dataSource:(dataViewId:'537f0c0a-3b04-5c03-8b9c-6eee829e73f8',type:dataView),filters:!(('$state':(store:appState),meta:(alias:!n,disabled:!f,field:labels.fix_sessionid,index:'537f0c0a-3b04-5c03-8b9c-6eee829e73f8',key:labels.fix_sessionid,negate:!f,params:(query:'SESSION_REPLACEMENT'),type:phrase),query:(match_phrase:(labels.fix_sessionid:'SESSION_REPLACEMENT')))),grid:(),hideChart:!f,interval:auto,query:(language:kuery,query:'labels.fix_msg_type:%20%220%22%20and%20labels.fix_event_handler_type:%20%22FromAdmin%22'),sort:!(!('@timestamp',asc)))",
    "ticket_group": "Monitoring and Analytics - Testing",
    "id": "sdpmt_53002_from_admin",
    "data_hot": "data_hot",
    "priority_by_account": {
      "hedgeserv-app-prd": "1 - Critical",
      "hedgeserv-app-tst": "3 - Moderate"
    }
  },
  "transform": {
    "script": {
      "source": """
        // grab hostnames with open tickets and remember their IDs in a map
        Map opened = ctx.payload.open_tickets.hits.hits.stream().collect(Collectors.toMap(h -> h._source.host.target, h -> h._source.ticket_id));

        // session -> cloud.account.name from fix_session_schedule (available even when the log is missing).
        // Keyed by the raw fix_sessionid (target.keyword in the schedule), before the _FromAdmin suffix is added.
        // Defensive: skip hosts whose schedule doc has no account populated, and handle both a
        // nested {"cloud": {"account": {"name": "..."}}} shape and a flat {"cloud.account.name": "..."} shape.
        Map session_to_account = new HashMap();
        for (def bucket: ctx.payload.groups.aggregations.hosts.buckets) {
          if (bucket.account == null || bucket.account.hits == null
              || bucket.account.hits.hits == null || bucket.account.hits.hits.length == 0) {
            continue;
          }
          def source = bucket.account.hits.hits.0._source;
          if (source == null) {
            continue;
          }
          def acct = null;
          if (source instanceof Map && source.containsKey('cloud.account.name')) {
            acct = source.get('cloud.account.name');
          } else if (source.cloud != null && source.cloud.account != null) {
            acct = source.cloud.account.name;
          }
          if (acct != null) {
            session_to_account.put(bucket.key, acct);
          }
        }

        // session -> errors bucket (present only when the log is present); used for cloud.region
        Map session_details = new HashMap();
        for (def bucket: ctx.payload.errors.aggregations.session_id.buckets) {
          session_details.put(bucket.key, bucket);
        }

        // store two lists of host buckets
        List to_open = [];
        List to_comment = [];
        String suffix = '_FromAdmin';
        for (def session: ctx.payload.sessions._value) {
          Map host = new HashMap();
          host.key = session;
          // strip only the trailing suffix (replace-all would also drop the marker
          // when a fix_sessionid value contains "_FromAdmin" internally)
          if (session.endsWith(suffix)) {
            host.session_id = session.substring(0, session.length() - suffix.length());
          } else {
            host.session_id = session;
          }
          host.dashboard_link = ctx.metadata.dashboard_link.replace('SESSION_REPLACEMENT', host.session_id);

          // account always comes from the schedule map (fix_session_schedule doesn't carry cloud.region,
          // so region is enriched from the log bucket when present, otherwise blank)
          host.cloud_account_name = session_to_account.getOrDefault(host.session_id, '');
          def bucket = session_details.get(host.session_id);
          if (bucket != null) {
            def source = bucket.data.hits.hits.0._source;
            host.cloud_region = source.cloud.region;
          } else {
            host.cloud_region = '';
          }

          // priority driven by the cloud account via ctx.metadata.priority_by_account;
          // falls back to ctx.metadata.ticket_priority if the account isn't mapped
          Map priority_map = ctx.metadata.priority_by_account;
          if (priority_map != null && priority_map.containsKey(host.cloud_account_name)) {
            host.ticket_priority = priority_map.get(host.cloud_account_name);
          } else {
            host.ticket_priority = ctx.metadata.ticket_priority;
          }

          if (opened.containsKey(session)) {
            // annotate hosts that need to be opened with ticket ID
            host.ticket_id = opened[host.key];
            to_comment.add(host);
          } else {
            // either no ticket for the host, or a closed one, open a new one
            to_open.add(host);
          }
        }

        // replace payload with our two lists
        return [
          'to_open': to_open,
          'to_comment': to_comment
        ];
        """,
      "lang": "painless"
    }
  }
}
